  "findings": [
    {
      "code": "reconnection_recurred_without_service_recovery",
      "evidence": "A source worker report records source-write-boundary-timeout with capture/sender/interrupt joined. The client observes reader EOF and heartbeat reader-ended, then source-hook session failure. A agent run changes before the restored connection; its protected service epoch does not change. B reports remote EOF and clean source retirement. Both original protected-service epochs remain READY and both reconnected automatically."
    },
    {
      "code": "receiver_pause_and_local_pipe_backpressure",
      "evidence": "A pre-failure sampler window spans 2181.796ms and is 2082.860ms late, with one count in each final aggregate total-GC and stopping bucket. B has no comparable long sampler window in its captured trail. The worker sends advisory boundary batches to the A agent on the shared source pipe; sourceWriter.operation gives authority/gate/write a single 1s budget.",
      "inference": "A stalled reader is consistent with the attempted local boundary write timing out and closing the source transport. This is not proof of the exact OS/runtime cause of the GC stopping delay, nor proof of pure network loss."
    },
    {
      "code": "do_not_suppress_attempted_writes",
      "evidence": "source-write-boundary-timeout is distinct from native pre-submission proof. writeSequenced must fence attempted/partial writes because sequence delivery is uncertain; blindly retrying or swallowing this error can corrupt the stream.",
      "nextFocus": "Investigate A runtime stopping delay and isolate or reduce advisory boundary traffic before submission. Preserve actual retirement checks and never renew stale authority or replay an attempted frame."
    },
    {
      "code": "successful_crossings_do_not_establish_reliability",
      "evidence": "Complete exchanges precede this later session failure. Samples are retained software timings, not physical mouse-to-display latency, and do not identify the exact user test start."
    }
  ],
